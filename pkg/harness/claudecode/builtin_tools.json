  {
    "name": "DesignSync",
    "useKind": "edit",
    "description": "Read or update claude.ai Design projects",
    "inputSchema": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "list_projects",
            "get_project",
            "list_files",
            "get_file",
            "finalize_plan",
            "write_files",
            "delete_files",
            "register_assets",
            "unregister_assets",
            "create_project",
            "report_validate"
          ]
        },
        "projectId": { "type": "string" },
        "path": { "type": "string" },
        "writes": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 256
        },
        "deletes": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 256
        },
        "planId": { "type": "string" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "localPath": { "type": "string" },
              "data": { "type": "string" },
              "encoding": { "type": "string", "const": "base64" },
              "mimeType": { "type": "string" }
            },
            "required": ["path"],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 256
        },
        "name": { "type": "string" },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "path": { "type": "string" },
              "subtitle": { "type": "string" },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": { "type": "number" },
                  "height": { "type": "number" }
                },
                "required": ["width"],
                "additionalProperties": false
              },
              "group": { "type": "string" }
            },
            "required": ["name", "path"],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "localDir": { "type": "string" },
        "counts": {
          "type": "object",
          "properties": {
            "total": { "type": "number" },
            "bad": { "type": "number" },
            "thin": { "type": "number" },
            "variantsIdentical": { "type": "number" },
            "iterations": { "type": "number" }
          },
          "required": ["total", "bad", "thin", "variantsIdentical", "iterations"],
          "additionalProperties": false
        }
      },
      "required": ["method"],
      "additionalProperties": false
    }
  },
