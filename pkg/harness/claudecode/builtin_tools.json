    "name": "SendMessage",
    "useKind": "edit",
    "description": "Send a plain-text or protocol message to another agent",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "summary": { "type": "string", "maxLength": 200 },
        "message": {
          "anyOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "shutdown_request" },
                "reason": { "type": "string" }
              },
              "required": ["type"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "shutdown_response" },
                "request_id": { "type": "string" },
                "approve": { "type": "boolean" },
                "reason": { "type": "string" }
              },
              "required": ["type", "request_id", "approve"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "plan_approval_response" },
                "request_id": { "type": "string" },
                "approve": { "type": "boolean" },
                "feedback": { "type": "string" }
              },
              "required": ["type", "request_id", "approve"],
              "additionalProperties": false
            }
          ]
        }
